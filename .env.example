# Copy to .env.local (git-ignored) to skip setup when running `pnpm dev`.
# Read at runtime by the unpackaged dev app only; release builds never use it.
YEISHIN_SERVER_URL=https://navidrome.example.com
YEISHIN_USERNAME=
YEISHIN_PASSWORD=
# Optional: navidrome (default), subsonic or jellyfin
YEISHIN_SERVER_TYPE=navidrome
YEISHIN_SERVER_NAME=Navidrome
# Optional: Yabbyville token (yv_...), set once if none is saved yet
YEISHIN_YABBY_TOKEN=
